import React, { useState } from 'react'
import { IconCalendar, IconChecklist, IconChevronDown, IconChevronRight, IconCopy, IconDots, IconNotebook, IconPencil, IconReceipt, IconShare, IconShoppingCart, IconTemplate, IconTrash, IconX } from '@tabler/icons-react'

// Hönnunarkerfi: eitt hlutlaust tákn-box, línutákn í stað emoji og litaðra reita.
const TYPE = {
  shopping: { Icon: IconShoppingCart },
  task: { Icon: IconChecklist },
  schedule: { Icon: IconCalendar },
  budget: { Icon: IconNotebook },
}

export default function ListsPanel({ lists, currentId, onSwitch, onCreate, onDelete, onShare, onDuplicate, onRename, templates = [], onCreateFromTemplate, onScanReceipt, onOpenBudget, userEmail, onSignOut, onClose }) {
  const [name, setName] = useState('')
  const [newType, setNewType] = useState('shopping')
  const [creating, setCreating] = useState(false)
  const [actionList, setActionList] = useState(null)
  const [showTemplates, setShowTemplates] = useState(false)

  const create = () => {
    const v = name.trim()
    if (!v) return
    onCreate(v, newType); setName(''); setCreating(false)
  }

  const tellFriend = async () => {
    const url = 'https://tossalisti.is'
    const text = 'Ég nota Tossalista — íslenskt app fyrir innkaupa- og verkefnalista, deilanlegt með fjölskyldu og vinum. Prófaðu:'
    if (navigator.share) {
      try { await navigator.share({ title: 'Tossalisti', text, url }) } catch (e) { /* hætt við */ }
    } else {
      try { await navigator.clipboard.writeText(text + ' ' + url) } catch (e) { /* clipboard læst */ }
    }
  }
  const tp = (l) => TYPE[l.type] || TYPE.shopping

  const row = (l) => (
    <div className={'lrow2' + (l.id === currentId ? ' active' : '')} key={l.id}>
      <span className="ltype">{React.createElement(tp(l).Icon, { size: 20, stroke: 1.75 })}</span>
      <div className="linfo" onClick={() => onSwitch(l.id)}>
        <div className="lname">{l.name}{l.shared && <span className="shared-tag">deilt</span>}</div>
        <div className="lcount">{l.type === 'budget' ? 'Bókhald' : `${l.items.length} ${l.type === 'shopping' ? 'vörur' : 'verk'}`}</div>
      </div>
      <button className="ico" onClick={() => setActionList(l)} aria-label="Aðgerðir"><IconDots size={20} stroke={1.75} /></button>
    </div>
  )

  return (
    <>
      <div className="sheet-bg" onClick={onClose}>
        <div className="sheet" onClick={e => e.stopPropagation()}>
          <h2>Listarnir mínir <button className="x" onClick={onClose} aria-label="Loka"><IconX size={20} stroke={1.75} /></button></h2>

          {!creating ? (
            <button className="primary-btn" onClick={() => setCreating(true)}>+ Nýr listi</button>
          ) : (
            <div className="create-box">
              <div className="seg seg3" style={{ marginBottom: 8 }}>
                <button className={newType === 'shopping' ? 'on' : ''} onClick={() => setNewType('shopping')}><IconShoppingCart size={16} stroke={1.75} /> Innkaup</button>
                <button className={newType === 'task' ? 'on' : ''} onClick={() => setNewType('task')}><IconChecklist size={16} stroke={1.75} /> Verk</button>
                <button className={newType === 'schedule' ? 'on' : ''} onClick={() => setNewType('schedule')}><IconCalendar size={16} stroke={1.75} /> Skema</button>
              </div>
              <div className="newrow">
                <input autoFocus value={name} onChange={e => setName(e.target.value)} onKeyDown={e => e.key === 'Enter' && create()} placeholder={newType === 'schedule' ? 't.d. Heimilisskema…' : newType === 'task' ? 't.d. Brúðkaup…' : 't.d. Matarboð…'} />
                <button onClick={create}>Búa til</button>
              </div>
            </div>
          )}

          {onScanReceipt && (
            <button className="scan-receipt-btn" onClick={onScanReceipt}><IconReceipt size={18} stroke={1.75} /> Skrá kvittun</button>
          )}
          {onOpenBudget && (
            <button className="budget-link-btn" onClick={onOpenBudget}><IconNotebook size={18} stroke={1.75} /> Bókhald & útgjöld</button>
          )}

          <div className="sheet-label">Mínir listar</div>
          {lists.map(row)}

          <button className="tpl-link" onClick={() => setShowTemplates(s => !s)}>
            <span className="inline-row"><IconTemplate size={18} stroke={1.75} /> Sniðmát</span>
            <span style={{ marginLeft: 'auto', color: 'var(--muted)' }}>{showTemplates ? <IconChevronDown size={17} stroke={1.75} /> : <IconChevronRight size={17} stroke={1.75} />}</span>
          </button>
          {showTemplates && (
            <div className="tpl-grid">
              {templates.map(t => (
                <button className="tpl-card" key={t.id} onClick={() => onCreateFromTemplate(t)}>
                  <span className="tpl-emoji">{t.emoji}</span>
                  <span className="tpl-name">{t.name}</span>
                </button>
              ))}
            </div>
          )}

          <button className="tellfriend-btn" onClick={tellFriend}><IconShare size={18} stroke={1.75} /> Segðu vini frá Tossalista</button>

          {onSignOut && (
            <div className="sheet-footer">
              {userEmail && <span className="sheet-user">{userEmail}</span>}
              <button className="signout-btn" onClick={onSignOut}>Skrá út</button>
            </div>
          )}
        </div>
      </div>

      {actionList && (
        <div className="sheet-bg center" onClick={() => setActionList(null)}>
          <div className="modal" onClick={e => e.stopPropagation()}>
            <h2 style={{ textTransform: 'capitalize' }}>{actionList.name} <button className="x" onClick={() => setActionList(null)} aria-label="Loka">×</button></h2>
            <button className="action-row" onClick={() => { onRename(actionList); setActionList(null) }}><IconPencil size={18} stroke={1.75} /> Endurnefna</button>
            <button className="action-row" onClick={() => { onDuplicate(actionList); setActionList(null) }}><IconCopy size={18} stroke={1.75} /> Afrita</button>
            <button className="action-row" onClick={() => { onShare(actionList); setActionList(null) }}><IconShare size={18} stroke={1.75} /> Deila</button>
            <button className="action-row danger" onClick={() => { onDelete(actionList); setActionList(null) }}><IconTrash size={18} stroke={1.75} /> Eyða</button>
          </div>
        </div>
      )}
    </>
  )
}
